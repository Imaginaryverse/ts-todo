{
	"name": "ts-todo",
	"version": "1.0.0",
	"private": true,
	"description": "A simple fullstack TypeScript monorepo example",
	"keywords": [],
	"license": "ISC",
	"author": "Anton Bertilsson",
	"type": "module",
	"scripts": {
		"tc": "tsc && pnpm --recursive --if-present tc",
		"lint": "oxlint --deny-warnings",
		"lint:fix": "oxlint --fix",
		"fmt": "oxfmt --check",
		"fmt:fix": "oxfmt"
	},
	"devDependencies": {
		"lefthook": "2.2.2",
		"oxfmt": "0.75.0",
		"oxlint": "1.90.0",
		"typescript": "catalog:"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.16.1",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.16.1"
}
