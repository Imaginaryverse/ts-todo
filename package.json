{
	"name": "ts-todo",
	"version": "1.0.0",
	"private": true,
	"description": "A simple fullstack TypeScript monorepo example",
	"keywords": [],
	"license": "ISC",
	"author": "Anton Bertilsson",
	"type": "module",
	"scripts": {
		"dev": "pnpm --recursive --parallel dev",
		"services:up": "docker compose up --detach --wait",
		"services:down": "docker compose down",
		"services:reset": "docker compose down --volumes && docker compose up --detach --wait",
		"db:generate": "pnpm --filter @ts-todo/db db:generate",
		"db:migrate": "pnpm --filter @ts-todo/db db:migrate",
		"db:seed": "pnpm --filter @ts-todo/api db:seed",
		"db:studio": "pnpm --filter @ts-todo/db db:studio",
		"tc": "tsc && pnpm --recursive --if-present --no-bail --no-sort tc",
		"lint": "oxlint --deny-warnings",
		"lint:fix": "oxlint --fix",
		"fmt": "oxfmt --check",
		"fmt:fix": "oxfmt",
		"test": "pnpm services:up && vitest run",
		"test:watch": "pnpm services:up && vitest",
		"test:e2e": "pnpm services:up && pnpm --filter @ts-todo/e2e test"
	},
	"devDependencies": {
		"lefthook": "2.2.2",
		"oxfmt": "0.75.0",
		"oxlint": "1.90.0",
		"typescript": "catalog:",
		"vitest": "5.0.5"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.16.1",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "24.18.0",
			"onFail": "download"
		}
	},
	"engines": {
		"node": ">=24 <25"
	},
	"packageManager": "pnpm@12.16.1"
}
