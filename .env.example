# Postgres container (docker-compose.yml)
POSTGRES_USER=ts_todo
POSTGRES_PASSWORD=ts_todo
POSTGRES_DB=ts_todo
POSTGRES_PORT=5432

# API and Drizzle Kit
DATABASE_URL=postgres://ts_todo:ts_todo@localhost:5432/ts_todo

# Origin the UI is served from (Vite dev server); used for CSRF protection
APP_ORIGIN=http://localhost:5173

# Tests (created and migrated automatically)
TEST_DATABASE_URL=postgres://ts_todo:ts_todo@localhost:5432/ts_todo_test

# Better Auth. Local development and tests use built-in defaults, so these can stay commented out.
# Production must set both (the API refuses to start otherwise):
# BETTER_AUTH_SECRET=   generate with `openssl rand -base64 32`
# BETTER_AUTH_URL=      the API's public https:// URL
